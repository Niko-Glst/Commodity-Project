# Kopieer dit bestand naar .env en vul je eigen sleutel in.
# .env staat in .gitignore en mag nooit gecommit worden.

# Gratis API-sleutel: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Optioneel: overschrijf de standaard cachelocatie (data/cache in de projectmap).
# CACHE_DIR=C:\Users\...\ergens\anders
